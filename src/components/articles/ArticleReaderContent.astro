---
import YouTubeFacade from '../media/YouTubeFacade.astro';
import type { Article } from '../../lib/data';
import { splitYouTubeEmbeds } from '../../lib/embeds';
import { formatDate } from '../../lib/format';

interface Props {
  article: Article;
}
const { article } = Astro.props;
const { cta } = article;
const segments = splitYouTubeEmbeds(article.body);
const external = cta !== undefined && cta.href.startsWith('https://');
---

<div class="reader-category">{article.label}</div>
<h1 class="reader-title">{article.title}</h1>
<div class="reader-meta">
  <span>{formatDate(article.date)}</span>
  <span>{article.duration}</span>
</div>
<div class="reader-body">
  {segments.map((segment) =>
    segment.kind === 'youtube' ? (
      <YouTubeFacade id={segment.id} title={segment.title} />
    ) : (
      <Fragment set:html={segment.html} />
    ),
  )}
</div>
{cta && (
  <div class="reader-cta">
    <h3>{cta.title}</h3>
    <p>{cta.text}</p>
    <a
      href={cta.href}
      class="cta-button"
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      {cta.buttonText}
    </a>
  </div>
)}
