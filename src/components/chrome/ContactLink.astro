---
import { CONTACT_SEALED, type ContactKind } from '../../config/site';

interface Props {
  kind: ContactKind;
  class?: string;
  /** Fixed visible text (e.g. "Connect With Us"); by default the address itself is shown once revealed. */
  label?: string;
}
const { kind, class: className, label } = Astro.props;
const placeholder = kind === 'email' ? 'Show email address' : 'Show phone number';
---

{/* Until a person interacts with the page the link only points to the footer's contact section. */}
<a
  href="#contact"
  class={className}
  data-contact={kind}
  data-sealed={CONTACT_SEALED[kind]}
  data-keep-label={label === undefined ? undefined : ''}
>
  {label ?? placeholder}
</a>

<script>
  import { unseal } from '../../lib/contact-seal';

  /*
   * Addresses are unsealed only after the first deliberate user input: a press, touch, wheel scroll or key. Search-engine
   * renderers and harvesting bots run the page but produce none of these, so the address never enters the DOM they
   * read; events a script dispatches are untrusted and ignored. Pointer *movement* is not used: browsers synthesise
   * trusted mouse-move events by themselves when layout shifts under a resting cursor.
   */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-sealed]')];
  const INPUT_EVENTS = ['pointerdown', 'touchstart', 'wheel', 'keydown'] as const;

  const onInput = (e: Event) => {
    if (e.isTrusted) reveal();
  };

  const reveal = () => {
    for (const type of INPUT_EVENTS) window.removeEventListener(type, onInput);
    for (const link of links) {
      const value = unseal(link.dataset['sealed'] ?? '');
      link.href = link.dataset['contact'] === 'email' ? `mailto:${value}` : `tel:${value.replace(/[^\d+]/g, '')}`;
      if (link.dataset['keepLabel'] === undefined) link.textContent = value;
      delete link.dataset['sealed'];
    }
  };

  if (links.length > 0) {
    for (const type of INPUT_EVENTS) window.addEventListener(type, onInput, { passive: true });
    // Assistive technology can activate a link with no other input first; that click is trusted, so reveal and follow.
    for (const link of links) {
      link.addEventListener('click', (e) => {
        if (e.isTrusted && link.dataset['sealed'] !== undefined) reveal();
      });
    }
  }
</script>
