---
import { encodedContact, type ContactKind } from '../../lib/contact';

interface Props {
  kind: ContactKind;
  class?: string;
  /** Fixed visible text (e.g. "Connect With Us"); by default the decoded address is shown. */
  label?: string;
}
const { kind, class: className, label } = Astro.props;
const placeholder = kind === 'email' ? 'Contact Email' : 'Contact Phone';
---

<!-- Without JavaScript the link falls back to the footer's contact section. -->
<a
  href="#contact"
  class={className}
  data-contact={kind}
  data-contact-value={encodedContact(kind)}
  data-keep-label={label && ''}
>
  {label ?? placeholder}
</a>

<script>
  // Decode build-time-encoded contact details into real mailto:/tel: links.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-contact-value]')) {
    const value = [...atob(link.dataset['contactValue'] ?? '')].reverse().join('');
    link.href = link.dataset['contact'] === 'email' ? `mailto:${value}` : `tel:${value.replace(/[^\d+]/g, '')}`;
    if (link.dataset['keepLabel'] === undefined) link.textContent = value;
  }
</script>
