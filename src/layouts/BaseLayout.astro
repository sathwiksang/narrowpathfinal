---
import '../styles/base.css';
import AskDrSunnyFloat from '../components/chrome/AskDrSunnyFloat.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import SiteNav from '../components/chrome/SiteNav.astro';
import { SITE } from '../config/site';
import {
  PORTRAIT_PATH,
  absoluteUrl,
  breadcrumbs,
  founder,
  organization,
  webPage,
  website,
  type Crumb,
} from '../lib/schema';

interface Props {
  /** Full document title. */
  title: string;
  description: string;
  /** Canonical path, e.g. `/about.html`. */
  path: string;
  /** Breadcrumb trail below Home; omit on the home page. */
  crumbs?: readonly Crumb[];
  /** schema.org type of the page node (WebPage, ProfilePage, CollectionPage, …). */
  pageType?: string;
  ogType?: 'website' | 'profile' | 'article';
  socialTitle?: string;
  socialDescription?: string;
  mainEntity?: Record<string, unknown>;
  extraNodes?: readonly Record<string, unknown>[];
  publishedTime?: string;
  /** Error pages: keep out of the index and emit no canonical URL or structured data. */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  crumbs = [],
  pageType = 'WebPage',
  ogType = 'website',
  socialTitle = title,
  socialDescription = description,
  mainEntity,
  extraNodes = [],
  publishedTime,
  noindex = false,
} = Astro.props;

const url = absoluteUrl(path);
const image = absoluteUrl(PORTRAIT_PATH);
const trail = [{ name: 'Home', path: '/' }, ...crumbs];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organization(),
    founder(),
    website(),
    webPage({
      url,
      type: pageType,
      name: title,
      description,
      hasBreadcrumb: true,
      ...(mainEntity ? { mainEntity } : {}),
    }),
    breadcrumbs(url, trail),
    ...extraNodes,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.founder} />
    <meta
      name="robots"
      content={
        noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      }
    />
    {!noindex && <link rel="canonical" href={url} />}
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1600" />
    <meta property="og:image:alt" content={SITE.founder} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={image} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
    <noscript>
      <style>
        .fade-in {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteNav currentPath={path} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <AskDrSunnyFloat />
    <script>
      // Reveal `.fade-in` elements as they scroll into view.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' },
      );
      for (const el of document.querySelectorAll('.fade-in')) observer.observe(el);
    </script>
  </body>
</html>
